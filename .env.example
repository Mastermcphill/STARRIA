# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://starria:starria@localhost:5432/starria"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── Storage (S3 / Cloudflare R2) ──────────────────────────────────────────────
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT_URL=""
PUBLIC_MEDIA_BASE_URL="http://localhost:3000/media"

# ── LiveKit ───────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL="wss://localhost:7880"

# ── Push Notifications (FCM) ──────────────────────────────────────────────────
FCM_SERVER_KEY=""

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"

# ── Media scanning ────────────────────────────────────────────────────────────
MEDIA_SCAN_SECRET=""
