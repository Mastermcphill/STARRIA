# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://starria:starria@localhost:5432/starria"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
# MUST be >=32 random chars in production (boot fails otherwise). Generate with:
#   openssl rand -hex 32
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
# Optional dedicated refresh-token secret (defaults to "${JWT_SECRET}:refresh").
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="30d"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of origins. Empty in production = no cross-origin.
# Example: CORS_ORIGINS="https://app.starria.com,https://admin.starria.com"
CORS_ORIGINS=""

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
# R2 Account ID — found in the Cloudflare dashboard sidebar (right-hand panel).
R2_ACCOUNT_ID=""
# R2 API token credentials (R2 → Manage API Tokens → Create API Token).
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# R2 bucket name (created in Cloudflare dashboard).
R2_BUCKET=""
# Public domain for the bucket (Settings → Public access → Custom domain).
# Example: https://media.starria.com
R2_PUBLIC_BASE_URL="http://localhost:3000/media"

# ── LiveKit ───────────────────────────────────────────────────────────────────
# REQUIRED. All three of API_KEY, API_SECRET and URL must be set or the API
# refuses to boot — there is no stub/dev-token fallback. Webhook signatures are
# verified with the same key+secret. Point your LiveKit project's webhook URL at
#   POST {API_BASE}/api/v1/webhooks/livekit
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL="wss://localhost:7880"
# Host base for server-side RoomServiceClient (https, not wss). e.g. https://my.livekit.cloud
LIVEKIT_HOST="http://localhost:7880"
# Optional: comma-separated allowlist of source IPs/CIDRs for the LiveKit webhook
# (defence-in-depth alongside signature verification). Empty = allow all.
LIVEKIT_WEBHOOK_IPS=""

# ── Payments — multi-provider registry ────────────────────────────────────────
# STARRIA routes money through three independent flows, each served by its own
# set of providers (see apps/api/src/modules/payments/provider-catalog.ts):
#   checkout     : buy coins (one-time)
#   subscription : recurring Star subscriptions
#   payout       : pay creators out (withdrawals)
#
# A provider is usable for a flow when its credential below is set. You can
# additionally force a provider on/off per flow WITHOUT redeploying via the admin
# API (POST /api/v1/admin/payments/toggle), or set a deploy-time default here:
#   PAYMENTS_<PROVIDER>_<CAPABILITY>_ENABLED = true | false
# Precedence at runtime:  DB admin override → env flag below → "credentials set?".
# Example: PAYMENTS_STRIPE_CHECKOUT_ENABLED="true"
#
# Hosted-checkout redirect targets (Stripe/Flutterwave/Korapay send the buyer
# here after payment). The reference is appended as ?ref=<reference>.
PAYMENTS_SUCCESS_URL="http://localhost:3000/pay/success"
PAYMENTS_CANCEL_URL="http://localhost:3000/pay/cancel"
# Optional IP allowlist (comma-separated IPs/CIDRs) for ALL payout webhooks at
# POST /webhooks/payout/:provider. Empty = allow all (logs a warning).
PAYOUT_WEBHOOK_IPS=""
#
# ── Payout conversion (coin → fiat) ──────────────────────────────────────────
# Coins are pegged to USD ($0.015/coin in code) then converted per currency.
# All maps are JSON overrides on top of the in-code defaults.
# Units of a currency per 1 USD, e.g. {"NGN":1600,"EUR":0.92}:
PAYOUT_FX_RATES=""
# Per-currency value multiplier on the USD peg (<1 = relatively cheaper). NGN is
# intentionally below 1, e.g. {"NGN":0.85}:
PAYOUT_CURRENCY_MULTIPLIERS=""
# Fee model — creator absorbs. Percentage of gross (e.g. 0.02) + flat minor units
# per currency (e.g. {"USD":50,"NGN":10000}):
PAYOUT_FEE_PERCENT="0.02"
PAYOUT_FEE_FLAT=""
# Minimum withdrawal in coins (rejects dust where the flat fee dominates).
# Default 100 (≈ $1.50 gross at $0.015/coin):
PAYOUT_MIN_COINS="100"
# Optional IP allowlist (comma-separated IPs/CIDRs) for ALL subscription webhooks
# at POST /webhooks/subscription/:provider. Empty = allow all (logs a warning).
SUBSCRIPTION_WEBHOOK_IPS=""
# Optional IP allowlist for recipient-onboarding webhooks (onboarding-heavy
# payout rails) at POST /webhooks/payout-onboarding/:provider. Empty = allow all.
PAYOUT_ONBOARDING_WEBHOOK_IPS=""
# Where the hosted payee-onboarding flow returns the user (Stripe Connect /
# Trolley / Tipalti). The recipient id is available to the client on return.
PAYOUT_ONBOARDING_RETURN_URL="http://localhost:3000/payouts/onboarded"
# Stripe Account Links also need a refresh URL (re-issues an expired link).
PAYOUT_ONBOARDING_REFRESH_URL="http://localhost:3000/payouts/onboard"

# ─ Paystack (checkout · subscription · payout) ─ Africa / NGN
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Used to verify x-paystack-signature on webhook callbacks (HMAC-SHA512 of body).
PAYSTACK_WEBHOOK_SECRET=""
# Optional: comma-separated allowlist of source IPs/CIDRs for the Paystack
# webhook (defence-in-depth alongside HMAC). Empty = allow all (logs a warning).
PAYSTACK_WEBHOOK_IPS=""

# ─ Korapay (checkout · payout) ─ Africa / NGN
KORAPAY_SECRET_KEY=""
KORAPAY_PUBLIC_KEY=""
KORAPAY_WEBHOOK_SECRET=""

# ─ Flutterwave (checkout · subscription · payout) ─ Africa / multi-currency
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
# Flutterwave signs webhooks with a "secret hash" sent as the verif-hash header.
FLUTTERWAVE_WEBHOOK_SECRET=""

# ─ Stripe (checkout · subscription · payout) ─ global / multi-currency
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Signing secret for the Stripe-Signature header (whsec_...).
STRIPE_WEBHOOK_SECRET=""
# Separate signing secret for the Stripe CONNECT webhook endpoint (account.updated
# + transfer.* events). Used by the stripe_connect payout rail. Reuses STRIPE_SECRET_KEY
# for API calls; only the webhook secret differs from the checkout endpoint.
STRIPE_CONNECT_WEBHOOK_SECRET=""

# ─ Tazapay (checkout) ─ global / cross-border escrow
TAZAPAY_API_KEY=""
TAZAPAY_API_SECRET=""
TAZAPAY_WEBHOOK_SECRET=""

# ─ Lemon Squeezy (checkout · subscription) ─ merchant-of-record
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
# A pay-what-you-want variant id used for coin checkouts (custom_price). For
# subscriptions, plans map to their own variant ids via SubscriptionPlan rows.
LEMONSQUEEZY_VARIANT_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# ─ Paddle (checkout · subscription) ─ merchant-of-record
PADDLE_API_KEY=""
# Product id used for the ad-hoc coin checkout price.
PADDLE_PRODUCT_ID=""
# Override for sandbox: https://sandbox-api.paddle.com
PADDLE_API_BASE=""
# Paddle Billing webhook signing secret (pdl_ntfset_...).
PADDLE_WEBHOOK_SECRET=""

# ─ Trolley ─ global mass payouts + hosted recipient onboarding widget
# Access/secret pair signs API requests (Authorization: prsign <key>:<hmac>).
TROLLEY_ACCESS_KEY=""
TROLLEY_SECRET_KEY=""
# Webhook signing secret — Stripe-style t=<unix>,v1=<hex> in X-PR-Signature.
TROLLEY_WEBHOOK_SECRET=""
# Override for sandbox, e.g. https://api.sandbox.trolley.com.
TROLLEY_API_BASE=""
# Hosted onboarding widget base (signed link is built from access/secret).
TROLLEY_WIDGET_BASE=""
# Currency of the balance we fund payouts from (default USD).
TROLLEY_SOURCE_CURRENCY="USD"

# ─ Wise (payout only) ─ global transfers
WISE_API_TOKEN=""
WISE_PROFILE_ID=""
# Override for sandbox: https://api.sandbox.transferwise.tech
WISE_API_BASE=""
# Currency of the Wise balance we fund transfers from (default USD).
WISE_SOURCE_CURRENCY="USD"
# PEM public key Wise signs webhooks with (X-Signature-SHA256, RSA-SHA256).
# Use literal \n for line breaks if storing on one line.
WISE_WEBHOOK_PUBLIC_KEY=""
WISE_WEBHOOK_SECRET=""

# ─ Tipalti ─ global mass payouts + hosted payee (Tipalti Hub) iframe onboarding
# API key signs the iframe URL (hashkey) and authenticates REST calls.
TIPALTI_API_KEY=""
TIPALTI_PAYER_NAME=""
# Webhook signing secret — HMAC-SHA256 hex in X-Tipalti-Signature.
TIPALTI_WEBHOOK_SECRET=""
# Override for sandbox, e.g. https://api.sandbox.tipalti.com.
TIPALTI_API_BASE=""
# Hosted payee iframe base (default https://ui2.tipalti.com).
TIPALTI_IFRAME_BASE=""
# Currency of the balance we fund payouts from (default USD).
TIPALTI_SOURCE_CURRENCY="USD"

# Apple / Google in-app purchase verification (native store rails — not part of
# the provider registry; governed by the app stores).
APPLE_IAP_SHARED_SECRET=""
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""

# ── Push Notifications (FCM) ──────────────────────────────────────────────────
FCM_SERVER_KEY=""

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"
# Event bus driver: "redis" (durable Redis Streams) or "memory" (dev/tests).
# Defaults to redis in production, memory otherwise.
EVENT_BUS_DRIVER=""

# ── Media scanning ────────────────────────────────────────────────────────────
MEDIA_SCAN_SECRET=""

# ── Content safety (Phase 3) ──────────────────────────────────────────────────
# Provider selection: "manual" (default, rule-based) or "cloud".
CONTENT_SAFETY_PROVIDER="manual"
# Cloud provider (only used when CONTENT_SAFETY_PROVIDER=cloud). Real HTTP path.
CONTENT_SAFETY_CLOUD_URL=""
CONTENT_SAFETY_CLOUD_KEY=""
CONTENT_SAFETY_BLOCK_THRESHOLD="0.9"
CONTENT_SAFETY_REVIEW_THRESHOLD="0.5"
CONTENT_SAFETY_TIMEOUT_MS="5000"

# ── Token revocation (Phase 2) ────────────────────────────────────────────────
# TTL of the per-user revoke-all watermark; must outlive the longest token.
REVOCATION_WATERMARK_TTL_SECONDS="2678400"

# ── Security (Phase 6) ────────────────────────────────────────────────────────
# Max request body size in bytes (uploads go direct to R2, so this stays small).
REQUEST_BODY_LIMIT_BYTES="1048576"
# Trust X-Forwarded-For (set "false" only if not behind a proxy/LB).
TRUST_PROXY="true"
# Override the default Content-Security-Policy for API / docs responses.
CONTENT_SECURITY_POLICY=""
DOCS_CONTENT_SECURITY_POLICY=""

# ── Feature flags ─────────────────────────────────────────────────────────────
# Master switch for the replay subsystem. When false/unset, all /replays
# endpoints return 503 (except GET /replays/capability, which reports status).
REPLAYS_ENABLED="false"
# Replay media processing (HLS passthrough + duration probe). Requires R2.
REPLAY_PROCESSING_ENABLED="false"
# Start LiveKit egress recording when rooms go live. Requires LiveKit + R2.
REPLAY_EGRESS_ENABLED="false"
# Optional R2 key prefix where egress writes thumbnail frames. Empty = no thumbs.
REPLAY_THUMBNAIL_PREFIX=""
