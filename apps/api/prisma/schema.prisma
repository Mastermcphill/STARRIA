// ─────────────────────────────────────────────────────────────────────────────
// MESSAGING (Sprint 5 — Prisma-backed; replaces in-memory MessageStorePort)
// ─────────────────────────────────────────────────────────────────────────────

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum DMAccessLevel {
  NOBODY
  SUPPORTERS
  PATRONS
  LEGENDS
  EVERYONE
  CUSTOM
}

enum MessageType {
  TEXT
  IMAGE
  GIFT_NOTIFICATION
  SYSTEM
}

model DmPermission {
  userId                  String        @id
  accessLevel             DMAccessLevel @default(NOBODY)
  customThresholdUsdCents Int?
  allowedUserIds          String[]
  updatedAt               DateTime      @updatedAt
}

model MessageRequest {
  id               String               @id @default(uuid())
  senderId         String
  recipientId      String
  senderPatronTier String
  openingMessage   String
  status           MessageRequestStatus @default(PENDING)
  sentAt           DateTime             @default(now())
  resolvedAt       DateTime?
  conversationId   String?

  @@index([recipientId, status])
  @@index([senderId])
}

model Conversation {
  id             String             @id @default(uuid())
  participantIds String[]
  status         ConversationStatus @default(ACTIVE)
  lastMessageAt  DateTime?
  openedAt       DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  messages       DirectMessage[]
  unreadCounters ConversationUnread[]

  @@index([participantIds])
}

model DirectMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  recipientId    String
  type           MessageType  @default(TEXT)
  body           String
  sentAt         DateTime     @default(now())

  @@index([conversationId, sentAt])
}

model ConversationUnread {
  conversationId String
  userId         String
  count          Int          @default(0)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

