{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  // src/adapters/prisma/** are unwired data-model repository stubs (not imported
  // by any module). They carry latent Prisma Json typing gaps; excluded from the
  // build until wired. See docs TODO. Everything else under src is compiled.
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "src/adapters/prisma/**"]
}
