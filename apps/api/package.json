{
  "name": "@starria/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.json",
    "test:cov": "jest --coverage",
    "harness:livekit": "node test/livekit-multiclient.harness.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@fastify/static": "^7.0.0",
    "@nestjs/cache-manager": "^2.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/throttler": "^5.0.0",
    "@prisma/client": "^5.0.0",
    "@starria/age-gate-core": "workspace:*",
    "@starria/analytics-core": "workspace:*",
    "@starria/arena-core": "workspace:*",
    "@starria/campaign-core": "workspace:*",
    "@starria/companion-core": "workspace:*",
    "@starria/creator-os-core": "workspace:*",
    "@starria/discovery-core": "workspace:*",
    "@starria/domain-events": "workspace:*",
    "@starria/feed-core": "workspace:*",
    "@starria/geo-core": "workspace:*",
    "@starria/gifting-core": "workspace:*",
    "@starria/live-core": "workspace:*",
    "@starria/messaging-core": "workspace:*",
    "@starria/moderation-core": "workspace:*",
    "@starria/notification-core": "workspace:*",
    "@starria/patron-core": "workspace:*",
    "@starria/ranking-core": "workspace:*",
    "@starria/replay-core": "workspace:*",
    "@starria/search-core": "workspace:*",
    "@starria/session-core": "workspace:*",
    "@starria/session-engine-core": "workspace:*",
    "@starria/star-core": "workspace:*",
    "@starria/support-core": "workspace:*",
    "@starria/ticketing-core": "workspace:*",
    "@starria/trust-core": "workspace:*",
    "@starria/video-core": "workspace:*",
    "@starria/voting-core": "workspace:*",
    "@starria/wallet-core": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^5.0.0",
    "cache-manager-redis-store": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.0.0",
    "livekit-server-sdk": "^2.6.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@livekit/rtc-node": "^0.13.29",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.0",
    "jest": "^29.0.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.5.0"
  }
}
